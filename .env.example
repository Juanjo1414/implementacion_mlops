# Copia este archivo como .env y cambia los valores:  cp .env.example .env
# .env está en .gitignore: el token real nunca se sube a GitHub.
#
# Token de administración: protege subir datos (/data/upload) y reentrenar
# (/retrain). Docker Compose se lo pasa a la API y al servicio cron.
# Genera uno con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=cambia-este-token

# Puerto local de Jupyter en Docker Compose (opcional). Cámbialo si 8888 ya
# está ocupado, por ejemplo por un Jupyter que corre fuera de Docker.
# JUPYTER_PORT=8889
